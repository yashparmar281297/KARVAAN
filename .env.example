# Copy to .env.local and fill in.
# Passcode for Login > Admin (skips phone OTP for the site admin).
ADMIN_PASSCODE=choose-a-passcode

# Test member login (a normal user): Login > Member.
MEMBER_ID=testrider
MEMBER_PASSWORD=choose-a-password
MEMBER_NAME=Test Rider

# Signs login cookies (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string
