{
  "name": "karvaan-app",
  "version": "1.0.0",
  "private": true,
  "description": "KARVAAN Android & iOS app (Capacitor shell around the KARVAAN website)",
  "scripts": {
    "sync": "node scripts/configure.mjs && cap sync",
    "apk": "node scripts/configure.mjs && cap sync android && cd android && gradlew assembleDebug",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
